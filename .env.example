# AutoScale-RL environment — copy to .env (gitignored) and fill in.
# The submission pipeline expects DagsHub for BOTH DVC and MLflow.

# --- DagsHub (DVC remote + MLflow tracking server) ---
DAGSHUB_USER=your-dagshub-username
DAGSHUB_TOKEN=your-dagshub-access-token
DAGSHUB_REPO=autoscale-rl

# --- MLflow tracking (auto-derived from DAGSHUB_USER/DAGSHUB_REPO if unset) ---
# https://dagshub.com/<owner>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token

# --- Optional explicit override of the tracking server ---
# MLFLOW_TRACKING_URI=https://dagshub.com/your-user/autoscale-rl.mlflow

# --- Git identity (set once per machine, not committed) ---
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
